{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "paperex 主窗口的默认权限：只开放核心能力与文件选择对话框",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "dialog:default",
    "dialog:allow-open"
  ]
}
